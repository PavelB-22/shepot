{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shepot",
  "version": "0.1.6",
  "identifier": "com.pavel.shepot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Shepot",
        "url": "index.html",
        "width": 560,
        "height": 640,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Shepot",
        "url": "overlay.html",
        "width": 560,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MDc3MEQwNkMyQjNENEEKUldSS1BTdHMwSEFIeG1acm1KaEV2ODV0THpuQSt3cmhEekFqNkdMS0Y2Y1JzTVJJOGpqQWNHdmkK",
      "endpoints": [
        "https://github.com/PavelB-22/shepot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
